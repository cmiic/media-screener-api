{
  "name": "NudeNet API",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "initializeCommand": "./scripts/provision-model.sh models/640m.onnx",
  "mounts": [
    "source=${localWorkspaceFolder}/models/640m.onnx,target=/models/640m.onnx,type=bind,readonly"
  ],
  "appPort": ["8080:8080"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postStartCommand": "uvicorn app:app --host 0.0.0.0 --port 8080 --reload"
}
