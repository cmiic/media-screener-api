# Media Screener Configuration
# Copy this file to .env and adjust as needed

# Container image name
IMAGE_NAME=media-screener

# Container instance name
CONTAINER_NAME=media-screener

# Port to expose on host
HOST_PORT=8080

# IP to bind on the host (loopback by default; do not expose directly)
HOST_IP=127.0.0.1

# Container resource limits
MEMORY_LIMIT=2g
CPU_LIMIT=2

# Request and parser resource limits
MAX_UPLOAD_SIZE=209715200
MAX_PDF_PAGES=100
MAX_PDF_RENDERED_PIXELS=100000000
MAX_VIDEO_DURATION_SECONDS=600
MAX_VIDEO_SAMPLED_FRAMES=120
MAX_DOCUMENT_IMAGES=100
MAX_CONCURRENT_SCANS=1
SCAN_QUEUE_TIMEOUT_SECONDS=5
UPLOAD_TIMEOUT_SECONDS=10
PROCESSING_TIMEOUT_SECONDS=40

# Host path to a model provisioned with scripts/provision-model.sh
MODEL_FILE=/opt/media-screener/models/640m.onnx
